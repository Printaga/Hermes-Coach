# Virtualenvs (root-anchored: a bare env/ would also shadow src/env/ or
# app/env/ source directories in a monorepo layout)
.venv/
venv/
/env/

# Bytecode
__pycache__/
*.py[cod]

# Test and build output
.pytest_cache/
/build/
/dist/
*.egg-info/
.eggs/
.coverage*
htmlcov/
.mypy_cache/
.ruff_cache/

# Secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem

# Tool scratch
.freebuff/

# Generated review output (at any depth, not just the repo root)
review.json

# CodeWiki scratch
.codewiki/
docs/wiki/temp/
docs/wiki/first_module_tree.json
.fallow/
